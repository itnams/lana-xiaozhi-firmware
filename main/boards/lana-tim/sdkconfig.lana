# Lana robot build overlay (used as the last SDKCONFIG_DEFAULTS file)
CONFIG_BOARD_TYPE_LANA_TIM=y
CONFIG_OLED_SSD1306_128X64=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m_lana.csv"
# Fallback only: the robot keeps the OTA URL saved in NVS (wifi/ota_url) if one is set
CONFIG_OTA_URL="https://xiaozhi.naelnguyen.dev/ota/"
CONFIG_LANGUAGE_VI_VN=y
# Wake phrases: MultiNet7 Chinese (pinyin) like the vendor firmware that already wakes on "hai la na";
# several phrases separated by ';'
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=n
CONFIG_SR_MN_CN_NONE=n
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=15
# Pinyin approximations of the Vietnamese calls (ESP-SR has no Vietnamese model):
#   hai la na ~ "Hi Lana", hei la na ~ "Hey Lana", ha lou la na ~ "Hello Lana" (these 3 = vendor fw),
#   la na ei ~ "Lana ơi", jiao la na ~ "Chào Lana". Display text is sent to the server as the wake word.
CONFIG_CUSTOM_WAKE_WORD="hai la na;hei la na;hai lan na;ha lou la na;ei la na;la na ei;la na wei;la na ai;la na e;lan na ei;la na ya;la na a;zhao la na;jiao la na;chao la na;xin chao la na;la na la na"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="Hi Lana;Hey Lana;Hi Lana;Hello Lana;Ê Lana;Lana ơi;Lana ơi;Lana ơi;Lana ơi;Lana ơi;Lana à;Lana à;Chào Lana;Chào Lana;Chào Lana;Xin chào Lana;Lana Lana"
# Match the vendor image: DIO 80 MHz, console on USB-Serial-JTAG (GPIO43/44 = tank motor B)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# 2.2.3: a starved/stuck task reboots the robot (reset reason TASK_WDT, reported as lana_reset) instead of hanging until power-cycled
CONFIG_ESP_TASK_WDT_PANIC=y

# --- Trim: Lana UI only uses lv_obj + label + image + flex (mono 128x64). Keep default theme & 16-bit
#     colour (esp_lvgl_port SSD1306 mono path converts from RGB565).
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTON=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_LODEPNG=n
CONFIG_LV_USE_SNAPSHOT=n
# CONFIG_LV_USE_IMGFONT kept: xiaozhi-fonts emoji fonts call lv_imgfont_create
CONFIG_LV_USE_OBSERVER=n
